# one merge job per cut
executable              = /afs/cern.ch/user/m/mcortino/private/ANALYSIS/plotsConfigurationsRDF/SSWW/Run3/jobsMerge/merge_one_cut.sh
arguments               = $(cutname)
output                  = /afs/cern.ch/user/m/mcortino/private/ANALYSIS/plotsConfigurationsRDF/SSWW/Run3/jobsMerge/merge_$(cutname).out
error                   = /afs/cern.ch/user/m/mcortino/private/ANALYSIS/plotsConfigurationsRDF/SSWW/Run3/jobsMerge/merge_$(cutname).err
log                     = /afs/cern.ch/user/m/mcortino/private/ANALYSIS/plotsConfigurationsRDF/SSWW/Run3/jobsMerge/merge_$(cutname).log
getenv                  = True
transfer_input_files    = /afs/cern.ch/user/m/mcortino/private/ANALYSIS/plotsConfigurationsRDF/SSWW/Run3/jobsMerge/krb5cc_staged
+JobFlavour             = "tomorrow"

queue cutname in (
  WW_SR
  WW_SR_ee
  WW_SR_mumu
  WW_SR_emu
)
